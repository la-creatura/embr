# the assertion helpers themselves: each one must pass when it should and raise a useful message when not
import "testing.embr"
import "embrlib"
import "str"

fn test_assert_eq_passes_and_fails()
    assert_eq(1, 1)
    e = assert_raises(fn() assert_eq(1, 2) end)
    assert_true(str_find(e["message"], "expected 2, got 1") >= 0)
    e2 = assert_raises(fn() assert_eq("a", "b", "context here") end)
    assert_true(str_find(e2["message"], "\"b\"") >= 0)
    assert_true(str_find(e2["message"], "context here") >= 0)
end

fn test_assert_ne_true_false()
    assert_ne(1, 2)
    assert_true(1)
    assert_false(0)
    assert_raises(fn() assert_ne(3, 3) end)
    assert_raises(fn() assert_true(0) end)
    assert_raises(fn() assert_false(1) end)
end

fn test_assert_near()
    assert_near(1.0, 1.0005, 0.001)
    assert_raises(fn() assert_near(1.0, 1.1, 0.001) end)
    assert_near(5, 4.9999, 0.01)
end

fn test_assert_raises_returns_the_error_and_checks_the_message()
    e = assert_raises(fn() error("disk full") end)
    assert_eq(e["message"], "disk full")
    assert_raises_with(fn() error("disk full") end, "disk")
    assert_raises(fn() assert_raises_with(fn() error("disk full") end, "memory") end)
    assert_raises(fn() assert_raises(fn() return 1 end) end)
end

fn test_fail_always_raises()
    e = assert_raises(fn() fail("nope") end)
    assert_true(str_find(e["message"], "nope") >= 0)
end
