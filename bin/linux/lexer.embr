# lexer.embr

# Token representation:
#
#   [kind, text, line, column]
#
# Examples:
#
#   ["identifier", "foo", 1, 1]
#   ["number",     "123", 1, 5]
#   ["string",     "hello", 1, 9]
#   ["plus",       "+", 2, 4]
#   ["eof",        "",  3, 1]


fn is_digit(c)
    return c >= "0" and c <= "9"
end


fn is_alpha(c)
    return (c >= "a" and c <= "z") or
           (c >= "A" and c <= "Z") or
           c == "_"
end


fn is_alnum(c)
    return is_alpha(c) or is_digit(c)
end


fn token(kind, text, line, col)
    return [kind, text, line, col]
end


fn lexer_error(message, line, col)
    print("[lexer] " + message + " at line " + str(line) + ", col " + str(col))
    return []
end


fn tokenize(src)
    local tokens = []

    local pos = 0
    local line = 1
    local col = 1
    local n = len(src)

    while pos < n
        local c = src[pos]

        # whitespace
        if c == " " or c == "\t" or c == "\r"
            pos += 1
            col += 1

        else if c == "\n"
            pos += 1
            line += 1
            col = 1

        # comments
        else if c == "#"
            while pos < n and src[pos] != "\n"
                pos += 1
                col += 1
            end

        # identifier / keyword
        else if is_alpha(c)
            local start_line = line
            local start_col = col
            local text = ""

            while pos < n and is_alnum(src[pos])
                text += src[pos]
                pos += 1
                col += 1
            end

            local kind = "identifier"

            if text == "if"
                kind = "if"
            else if text == "else"
                kind = "else"
            else if text == "end"
                kind = "end"
            else if text == "fn"
                kind = "fn"
            else if text == "return"
                kind = "return"
            else if text == "while"
                kind = "while"
            else if text == "import"
                kind = "import"
            else if text == "local"
                kind = "local"
            else if text == "and"
                kind = "and"
            else if text == "or"
                kind = "or"
            end

            tokens += [token(kind, text, start_line, start_col)]

        # number
        else if is_digit(c)
            local start_line = line
            local start_col = col
            local text = ""
            local dot = false

            while pos < n
                local ch = src[pos]

                if is_digit(ch)
                    text += ch
                    pos += 1
                    col += 1

                else if ch == "."
                    if dot
                        lexer_error(
                            "multiple decimal points",
                            start_line,
                            start_col
                        )
                        return []
                    end

                    dot = true
                    text += ch
                    pos += 1
                    col += 1

                else
                    break
                end
            end

            if text[len(text) - 1] == "."
                lexer_error(
                    "trailing decimal point",
                    start_line,
                    start_col
                )
                return []
            end

            tokens += [token("number", text, start_line, start_col)]

        # string
        else if c == "\""
            local start_line = line
            local start_col = col
            local text = ""

            # opening quote
            pos += 1
            col += 1

            local terminated = false

            while pos < n
                local ch = src[pos]

                if ch == "\""
                    pos += 1
                    col += 1
                    terminated = true
                    break
                end

                if ch == "\\"
                    pos += 1
                    col += 1

                    if pos >= n
                        lexer_error(
                            "unterminated escape",
                            start_line,
                            start_col
                        )
                        return []
                    end

                    local escaped = src[pos]

                    if escaped == "n"
                        text += "\n"
                    else if escaped == "t"
                        text += "\t"
                    else if escaped == "r"
                        text += "\r"
                    else if escaped == "0"
                        text += "\0"
                    else if escaped == "\""
                        text += "\""
                    else if escaped == "\\"
                        text += "\\"
                    else
                        lexer_error(
                            "unknown escape \\" + escaped,
                            line,
                            col
                        )
                        return []
                    end

                    pos += 1
                    col += 1

                else
                    text += ch

                    if ch == "\n"
                        line += 1
                        col = 1
                    else
                        col += 1
                    end

                    pos += 1
                end
            end

            if not terminated
                lexer_error(
                    "unterminated string literal",
                    start_line,
                    start_col
                )
                return []
            end

            tokens += [token("string", text, start_line, start_col)]

        # operators and punctuation
        else
            local start_line = line
            local start_col = col

            # Two-character operators first.

            if c == "+" and pos + 1 < n and src[pos + 1] == "="
                tokens += [token("plus_eq", "+=", line, col)]
                pos += 2
                col += 2

            else if c == "-" and pos + 1 < n and src[pos + 1] == ">"
                tokens += [token("r_arrow", "->", line, col)]
                pos += 2
                col += 2

            else if c == "-" and pos + 1 < n and src[pos + 1] == "="
                tokens += [token("minus_eq", "-=", line, col)]
                pos += 2
                col += 2

            else if c == "*" and pos + 1 < n and src[pos + 1] == "="
                tokens += [token("star_eq", "*=", line, col)]
                pos += 2
                col += 2

            else if c == "/" and pos + 1 < n and src[pos + 1] == "="
                tokens += [token("slash_eq", "/=", line, col)]
                pos += 2
                col += 2

            else if c == "=" and pos + 1 < n and src[pos + 1] == "="
                tokens += [token("equal_equal", "==", line, col)]
                pos += 2
                col += 2

            else if c == ">" and pos + 1 < n and src[pos + 1] == "="
                tokens += [token("greater_equal", ">=", line, col)]
                pos += 2
                col += 2

            else if c == "<" and pos + 1 < n and src[pos + 1] == "="
                tokens += [token("less_equal", "<=", line, col)]
                pos += 2
                col += 2

            else if c == "!" and pos + 1 < n and src[pos + 1] == "="
                tokens += [token("bang_equal", "!=", line, col)]
                pos += 2
                col += 2

            # Single-character operators / punctuation.

            else if c == "+"
                tokens += [token("plus", "+", line, col)]
                pos += 1
                col += 1

            else if c == "-"
                tokens += [token("minus", "-", line, col)]
                pos += 1
                col += 1

            else if c == "*"
                tokens += [token("star", "*", line, col)]
                pos += 1
                col += 1

            else if c == "/"
                tokens += [token("slash", "/", line, col)]
                pos += 1
                col += 1

            else if c == "%"
                tokens += [token("percent", "%", line, col)]
                pos += 1
                col += 1

            else if c == "("
                tokens += [token("lparen", "(", line, col)]
                pos += 1
                col += 1

            else if c == ")"
                tokens += [token("rparen", ")", line, col)]
                pos += 1
                col += 1

            else if c == "["
                tokens += [token("lbracket", "[", line, col)]
                pos += 1
                col += 1

            else if c == "]"
                tokens += [token("rbracket", "]", line, col)]
                pos += 1
                col += 1

            else if c == "{"
                tokens += [token("lcurly", "{", line, col)]
                pos += 1
                col += 1

            else if c == "}"
                tokens += [token("rcurly", "}", line, col)]
                pos += 1
                col += 1

            else if c == ","
                tokens += [token("comma", ",", line, col)]
                pos += 1
                col += 1

            else if c == "."
                tokens += [token("dot", ".", line, col)]
                pos += 1
                col += 1

            else if c == ":"
                tokens += [token("colon", ":", line, col)]
                pos += 1
                col += 1

            else if c == "="
                tokens += [token("equal", "=", line, col)]
                pos += 1
                col += 1

            else if c == ">"
                tokens += [token("greater", ">", line, col)]
                pos += 1
                col += 1

            else if c == "<"
                tokens += [token("less", "<", line, col)]
                pos += 1
                col += 1

            else if c == "!"
                tokens += [token("bang", "!", line, col)]
                pos += 1
                col += 1

            else
                lexer_error(
                    "unexpected character: " + c,
                    line,
                    col
                )
                return []
            end
        end
    end

    tokens += [token("eof", "", line, col)]

    return tokens
end