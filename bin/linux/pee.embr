import "embrlib"
lexer = {}
lexer = {
  line: 1, col: 1, i: 0,
  lines: [],
  acc_line: "",
  source: "",
  
  source_map: fn()
    if lexer.source[lexer.i] == "\n"
      lexer.col = 1
      lexer.line = 1
      lexer.lines = push(lexer.lines,lexer.acc_line)
      lexer.acc_line = ""
    else
      lexer.col = lexer.col + 1
      lexer.acc_line = lexer.acc_line + lexer.source[lexer.i]
    end
    return 2
  end,

  tokenise: fn(source: str)
    lexer.line = 1
    lexer.col = 1
    lexer.i = 0
    lexer.lines = []
    lexer.acc_line = ""
    lexer.source = source


    while lexer.i < len(lexer.source)
      lexer.source_map()
      lexer.i = lexer.i + 1
    end
    return 0
  end,

}

#print(lexer)
lexer.tokenise(load_file("pee.embr"))
i = 0
while i < len(lexer.lines)
  print(lexer.lines[i])
  i = i + 1
end